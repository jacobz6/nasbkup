# === Security: Sensitive files (NEVER commit) ===

# Encryption keys
*.key
master.key

# Configuration files with real credentials (OSS keys, rclone passwords, etc.)
config.yaml
**/config.yaml
*.conf
!**/*.conf.example
!**/config.yaml.example
!docker/nginx.conf

# rclone config (contains OSS credentials + crypt passwords)
rclone.conf
**/rclone.conf

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Data directory (runtime data, keys, logs)
**/data/
!**/data/.gitkeep

